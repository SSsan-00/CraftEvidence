<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>CraftEvidence</AssemblyName>
    <RootNamespace>CraftEvidence.App</RootNamespace>
    <Version>0.1.0-preview.17</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CraftEvidence.Core\CraftEvidence.Core.csproj" />
    <ProjectReference Include="..\CraftEvidence.Excel\CraftEvidence.Excel.csproj" />
  </ItemGroup>
</Project>
